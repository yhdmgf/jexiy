<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lan_qr_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#10131B">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageButton
            android:id="@+id/lan_qr_cancel"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:padding="15dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FF6961"
            android:contentDescription="@string/lan_qr_close" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toStartOf="@id/lan_qr_cancel"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:text="@string/lan_qr_title"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp" />
    </RelativeLayout>
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/lan_qr_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="22dp"
        android:gravity="center"
        android:text="@string/lan_qr_hint"
        android:textColor="#CED4E0"
        android:lineSpacingExtra="5dp"
        android:textSize="14sp" />
</LinearLayout>
